generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// ENUMS
// ============================================================

// Tipos de movimientos del inventario.
enum MovementType {
  IN
  OUT
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

// Unidades de medida de los productos.
enum UnitType {
  UNIT
  GRAM
  MILLILITER
}

// Tipos de movimientos de caja.
enum CashMovementType {
  SALE
  PURCHASE
  EXPENSE
  INCOME
  DEBT_PAYMENT
  DEBT_COLLECTION
  ADJUSTMENT
}

// Clasificación de las deudas.
enum DebtType {
  CLIENT
  SUPPLIER
}

// Estado de una deuda.
enum DebtStatus {
  OPEN
  PARTIAL
  PAID
}

// ============================================================
// 1. USUARIOS Y SESIONES
// ============================================================

// Usuario propietario de los datos del sistema.
model User {
  id        Int    @id @default(autoincrement())
  name      String
  user_name String @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones principales.
  sessions       Session[]
  products       Product[]
  sales          Sale[]
  purchases      Purchase[]
  stockMovements StockMovement[]

  // Finanzas.
  cashBoxes     CashBox[]
  cashMovements CashMovement[]
  debts         Debt[]
  debtPayments  DebtPayment[]

  // Locales y tickets.
  locales Local[]
  tickets Ticket[]
}

// Sesiones de autenticación.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// 2. CATEGORÍAS Y PRODUCTOS
// ============================================================

// Categorías utilizadas para clasificar productos.
model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  active      Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Producto maestro.
// Su stock representa la suma de las existencias de todos sus lotes.
model Product {
  id Int @id @default(autoincrement())

  name        String
  barcode     String? @unique
  description String?

  // Unidad de medida.
  unitType UnitType @default(UNIT)
  unit     String   @default("unidad")

  // Precio de venta y costo promedio de adquisición.
  price     Float
  costPrice Float

  // Existencias generales.
  stock    Float @default(0)
  minStock Int   @default(0)

  active Boolean @default(true)

  // Categoría.
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Propietario.
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Relaciones de inventario.
  presentations  ProductPresentation[]
  lots           ProductLot[]
  stockMovements StockMovement[]

  // Relaciones comerciales.
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  ticketItems   TicketItem[]

  // Campos antiguos de lote.
  // Se conservan temporalmente por compatibilidad.
  lotCode      String?
  purchaseDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([userId])
}

// ============================================================
// 3. PRESENTACIONES DE PRODUCTOS
// ============================================================

// Permite comprar o vender productos en diferentes formatos.
// Ejemplo: saco de 100 lb = factor 100.
model ProductPresentation {
  id Int @id @default(autoincrement())

  name   String
  factor Float

  canPurchase Boolean @default(true)
  canSell     Boolean @default(true)
  active      Boolean @default(true)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ============================================================
// 4. LOTES DE INVENTARIO
// ============================================================

// Cada lote representa una entrada independiente de mercancía.
// Un producto puede tener muchos lotes.
model ProductLot {
  id Int @id @default(autoincrement())

  lotCode      String?
  purchaseDate DateTime

  // Cantidad recibida originalmente.
  initialQuantity Float

  // Cantidad que todavía está disponible.
  availableQuantity Float

  // Costo por unidad base de este lote.
  unitCost Float

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // Compra que originó este lote.
  purchaseItemId Int?          @unique
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  // Ventas y movimientos asociados.
  saleAllocations SaleItemLot[]
  stockMovements  StockMovement[]

  createdAt DateTime @default(now())

  @@index([productId, purchaseDate])
}

// ============================================================
// 5. COMPRAS
// ============================================================

// Representa una compra completa.
model Purchase {
  id Int @id @default(autoincrement())

  total        Float
  paymentType  String?
  supplierName String?
  notes        String?

  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  items PurchaseItem[]
  debt  Debt?

  @@index([createdAt])
  @@index([userId])
}

// Cada registro representa una línea de una compra.
model PurchaseItem {
  id Int @id @default(autoincrement())

  // Cantidad y costo convertidos a unidades base.
  quantity Float
  unitCost Float
  subtotal Float

  // Información de la presentación comprada.
  purchasedQuantity  Float?
  purchasedUnitCost  Float?
  presentationName   String?
  presentationFactor Float?

  productName String?

  // Información del lote recibido.
  lotCode      String?
  purchaseDate DateTime?

  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Lote creado a partir de esta línea de compra.
  productLot ProductLot?

  @@index([purchaseId])
  @@index([productId])
}

// ============================================================
// 6. VENTAS
// ============================================================

// Representa una venta.
model Sale {
  id Int @id @default(autoincrement())

  total  Float
  profit Float @default(0)

  paymentType String?

  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  items SaleItem[]

  @@index([createdAt])
  @@index([userId])
}

// Detalle de cada producto vendido.
model SaleItem {
  id Int @id @default(autoincrement())

  quantity Float

  price     Float?
  unitPrice Float?
  costPrice Float?

  profit   Float @default(0)
  subtotal Float

  productName String?

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Lotes de donde se descontaron las unidades vendidas.
  lotAllocations SaleItemLot[]

  @@index([productId])
  @@index([saleId])
}

// Relaciona cada línea de venta con los lotes consumidos.
// Permite descontar cantidades de varios lotes en una misma venta.
model SaleItemLot {
  id Int @id @default(autoincrement())

  quantity Float

  saleItemId Int
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  productLotId Int
  productLot   ProductLot @relation(fields: [productLotId], references: [id])

  @@index([saleItemId])
  @@index([productLotId])
}

// ============================================================
// 7. MOVIMIENTOS DE INVENTARIO
// ============================================================

// Historial de entradas, salidas y ajustes de existencias.
model StockMovement {
  id Int @id @default(autoincrement())

  type     MovementType
  quantity Float

  note   String?
  reason String?

  createdAt DateTime @default(now())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // Lote relacionado, cuando corresponda.
  productLotId Int?
  productLot   ProductLot? @relation(fields: [productLotId], references: [id], onDelete: SetNull)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// 8. LOCALES Y TICKETS
// ============================================================

// Locales o puntos de venta pertenecientes a un usuario.
model Local {
  id Int @id @default(autoincrement())

  name    String
  address String?
  phone   String?
  email   String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tickets Ticket[]

  @@unique([userId, name])
  @@index([userId, active])
}

// Ticket o comprobante de venta.
model Ticket {
  id Int @id @default(autoincrement())

  number String

  subtotal Float
  discount Float @default(0)
  total    Float

  paymentType   String?
  paymentStatus DebtStatus @default(PAID)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  localId Int?
  local   Local? @relation(fields: [localId], references: [id], onDelete: SetNull)

  cashBoxId Int?
  cashBox   CashBox? @relation(fields: [cashBoxId], references: [id], onDelete: SetNull)

  items TicketItem[]
  debts Debt[]

  @@unique([userId, number])
  @@index([userId, createdAt])
  @@index([localId])
  @@index([cashBoxId])
  @@index([paymentStatus])
}

// Productos incluidos en un ticket.
model TicketItem {
  id Int @id @default(autoincrement())

  productName String
  quantity    Int
  unitCost    Float
  subtotal    Float

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([productId])
}

// ============================================================
// 9. CAJA Y MOVIMIENTOS FINANCIEROS
// ============================================================

// Caja de dinero de cada usuario.
model CashBox {
  id Int @id @default(autoincrement())

  name String

  initialCapital Float @default(0)
  currentBalance Float @default(0)

  currency String @default("CUP")

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  movements    CashMovement[]
  tickets      Ticket[]
  debtPayments DebtPayment[]

  @@index([userId, active])
}

// Historial de movimientos de dinero.
model CashMovement {
  id Int @id @default(autoincrement())

  type   CashMovementType
  amount Float

  description String?

  referenceType String?
  referenceId   Int?

  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  cashBoxId Int
  cashBox   CashBox @relation(fields: [cashBoxId], references: [id], onDelete: Cascade)

  @@index([cashBoxId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

// ============================================================
// 10. DEUDAS Y PAGOS
// ============================================================

// Deudas de clientes o proveedores.
model Debt {
  id Int @id @default(autoincrement())

  personName String
  type       DebtType

  total     Float
  remaining Float      @default(0)
  status    DebtStatus @default(OPEN)

  dueDate DateTime?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Deuda asociada a un ticket.
  ticketId Int?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  // Deuda asociada a una compra.
  purchaseId Int?      @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  payments DebtPayment[]

  @@index([userId, status])
  @@index([ticketId])
  @@index([type, status])
}

// Pagos realizados sobre una deuda.
model DebtPayment {
  id Int @id @default(autoincrement())

  amount Float
  notes  String?

  createdAt DateTime @default(now())

  debtId Int
  debt   Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  cashBoxId Int
  cashBox   CashBox @relation(fields: [cashBoxId], references: [id])

  @@index([debtId, createdAt])
  @@index([userId, createdAt])
  @@index([cashBoxId])
}
